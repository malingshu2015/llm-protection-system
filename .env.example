# LLM防火墙系统环境配置
# 复制此文件为 .env 并填入实际值

# API密钥配置
CHERRY_STUDIO_API_KEY=qxVAApk3FPxwL_KvUKF6UXu3W-6sWos0pa8vaHhggg8
DEMO_API_KEY=your-demo-key-here
ADMIN_API_KEY=your-admin-key-here

# 服务器配置
HOST=0.0.0.0
PORT=8082
DEBUG=false

# 安全设置
SECURITY_CONFIDENCE_THRESHOLD=0.8
SECURITY_BYPASS_DETECTION_FOR_DEV=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/llm-firewall.log

# 数据库配置（可选）
DATABASE_URL=sqlite:///llm_firewall.db

# Ollama配置
OLLAMA_HOST=localhost
OLLAMA_PORT=11434