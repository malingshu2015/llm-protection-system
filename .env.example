# LLM防火墙系统环境配置
# 复制此文件为 .env 并填入实际值

# API密钥配置
CHERRY_STUDIO_API_KEY=qxVAApk3FPxwL_KvUKF6UXu3W-6sWos0pa8vaHhggg8
DEMO_API_KEY=your-demo-key-here
ADMIN_API_KEY=your-admin-key-here

# 服务器配置
HOST=0.0.0.0
PORT=8082
DEBUG=false

# 安全设置
SECURITY_CONFIDENCE_THRESHOLD=0.8
SECURITY_BYPASS_DETECTION_FOR_DEV=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/llm-firewall.log

# 数据库配置（可选）
DATABASE_URL=sqlite:///llm_firewall.db

# Ollama配置
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# JWT认证配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# WebAuthn/FIDO2配置
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LLM防护系统
WEBAUTHN_RP_ORIGIN=http://localhost:8000
# 生产环境示例:
# WEBAUTHN_RP_ID=yourdomain.com
# WEBAUTHN_RP_NAME=LLM防护系统
# WEBAUTHN_RP_ORIGIN=https://yourdomain.com

# OAuth2配置 (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback/google

# OAuth2配置 (GitHub)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback/github