      "(?i)(?:territorial|领土|territory|territory)[.\\s]*(?:dispute|争议|conflict|冲突|sovereignty|主权)",
      "(?i)(?:支持|support|advocate|倡导)[.\\s]*(?:分裂|separatism|independence|独立)[.\\s]*(?:活动|movement|cause|事业)",
      "(?i)(?:两岸|台海|cross-strait)[.\\s]*(?:问题|issue|crisis|危机|tension|紧张)"
    ],
    "keywords": [
      "independence movement",
      "separatism",
      "territorial dispute",
      "sovereignty",
      "secession",
      "独立运动",
      "分裂主义",
      "领土争议",
      "主权问题",
      "分离运动"
    ],
    "priority": 11,
    "categories": ["political_sensitive", "territorial"],
    "block": true,
    "enabled": true
  },
  {
    "id": "ps-003",
    "name": "Political Conspiracy Theories",
    "description": "检测政治阴谋论和虚假政治信息",
    "detection_type": "political_sensitive",
    "severity": "medium",
    "patterns": [
      "(?i)(?:conspiracy|阴谋|conspiracy theory|阴谋论)[.\\s]*(?:about|关于|involving|涉及)[.\\s]*(?:government|政府|election|选举|politicians|政治家)",
      "(?i)(?:deep state|深度国家|shadow government|影子政府)",
      "(?i)(?:election|选举)[.\\s]*(?:fraud|舞弊|rigged|操纵|stolen|被盗)",
      "(?i)(?:false flag|假旗|staged|策划的)[.\\s]*(?:operation|行动|attack|攻击|event|事件)",
      "(?i)(?:政治|political)[.\\s]*(?:迫害|persecution|suppression|压制|censorship|审查)"
    ],
    "keywords": [
      "conspiracy theory",
      "deep state",
      "election fraud",
      "false flag",
      "political persecution",
      "阴谋论",
      "深度国家",
      "选举舞弊",
      "假旗行动",
      "政治迫害"
    ],
    "priority": 12,
    "categories": ["political_sensitive", "misinformation"],
    "block": false,
    "enabled": true
  },
  {
