[
  {
    "id": "ps-001",
    "name": "Political Extremism",
    "description": "检测极端政治观点和煽动性政治言论",
    "detection_type": "political_sensitive",
    "severity": "high",
    "patterns": [
      "(?i)(?:overthrow|推翻|颠覆)[.\\s]*(?:government|政府|regime|政权|system|制度)",
      "(?i)(?:revolution|革命|uprising|起义|rebellion|叛乱)[.\\s]*(?:against|反对|对抗)[.\\s]*(?:authority|当局|government|政府)",
      "(?i)(?:political|政治)[.\\s]*(?:violence|暴力|terrorism|恐怖主义)",
      "(?i)(?:assassination|暗杀|刺杀)[.\\s]*(?:of|对|针对)[.\\s]*(?:political|政治)[.\\s]*(?:leader|领导人|figure|人物|official|官员)",
      "(?i)(?:extremist|极端主义|radical|激进)[.\\s]*(?:ideology|思想|beliefs|信念|movement|运动)"
    ],
    "keywords": [
      "overthrow government",
      "political violence",
      "extremist",
      "radical politics",
      "revolution",
      "assassination",
      "推翻政府",
      "政治暴力",
      "极端主义",
      "激进政治",
      "政治革命",
      "政治暗杀"
    ],
    "priority": 10,
    "categories": ["political_sensitive", "extremism"],
    "block": true,
    "enabled": true
  },
  {
    "id": "ps-002",
    "name": "Separatism and Territory Disputes",
    "description": "检测分裂主义和领土争议敏感内容",
    "detection_type": "political_sensitive",
    "severity": "high",
    "patterns": [
